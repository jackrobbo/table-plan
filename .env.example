# Table Plan — environment. Copy to .env.local and fill in.
# Supabase project (UK/EU region). The publishable (anon) key is client-safe.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# NB: the secret key (sb_secret_…) is server-only — never put it here or in git.
#     It belongs in Vercel env vars if/when server code needs it.
